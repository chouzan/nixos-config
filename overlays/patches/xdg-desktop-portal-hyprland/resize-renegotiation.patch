+bool CScreencopyPortal::SSession::hasStableSize(uint32_t width, uint32_t height) {
+    if (sharingData.pendingWidth != width || sharingData.pendingHeight != height) {
+        sharingData.pendingWidth     = width;
+        sharingData.pendingHeight    = height;
+        sharingData.pendingSizeSince = std::chrono::steady_clock::now();
+        return false;
+    }
+
+    return std::chrono::steady_clock::now() - sharingData.pendingSizeSince >= RESIZE_SETTLE_TIME;
+}
