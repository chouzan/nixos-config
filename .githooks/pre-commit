#!/usr/bin/env bash
staged_nix=$(git diff --cached --name-only --diff-filter=ACM -- '*.nix')
[ -z "$staged_nix" ] && exit 0

echo "running nix checks on staged files..."

echo "  nixfmt..."
if ! echo "$staged_nix" | xargs nixfmt --check 2>/dev/null; then
  echo "error: nixfmt: formatting check failed. Run 'nix fmt' to fix."
  exit 1
fi

echo "  statix..."
if ! statix check . 2>&1; then
  echo "error: statix: lint warnings found."
  exit 1
fi

echo "  deadnix..."
if ! deadnix --fail . 2>&1; then
  echo "error: deadnix: dead code found."
  exit 1
fi

echo "all checks passed."
