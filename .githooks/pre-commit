#!/usr/bin/env bash

# Git is a fallback here, since Jujutsu drives this repository and never runs
# git hooks. The hook therefore has to work from a bare environment, so it asks
# Nix for the checks rather than expecting linters on PATH.

set -euo pipefail

staged_nix=$(git diff --cached --name-only --diff-filter=ACM -- '*.nix')
[ -z "$staged_nix" ] && exit 0

system=$(nix eval --impure --raw --expr builtins.currentSystem)

echo "running nix checks..."

# Both checks read the flake source, which for a git flake is the index, so
# staged changes are what they see.
nix build --no-link --print-build-logs \
  ".#checks.${system}.formatting" \
  ".#checks.${system}.nix-static"

echo "all checks passed."
